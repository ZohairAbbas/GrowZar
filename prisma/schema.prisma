// Growzar schema — skeleton for Phase 1.
//
// Scope of this file today: the tenancy spine (organization, store, app
// connection) plus the Better Auth models below the AppConnection block.
//
// Everything from `model User` down is GENERATED. `npm run auth:generate`
// rewrites it from app/lib/auth.server.ts; edit that config, not these models,
// or the next regeneration silently reverts you. Their table names stay at
// Better Auth's defaults (singular, camelCase) because `modelName` renames the
// Prisma model too, and `prisma.organization_roles` is a worse trade than a
// mixed table convention.
//
// Deliberately absent until their Phase 1 day: the synced order/parcel cache,
// the Growzar customer record, and the event relay's inbox.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the URL lives in prisma.config.ts (migrations) and in the pg
  // driver adapter (runtime). It is deliberately absent here.
}

/// The merchant's company. One base currency, one owner.
/// Money across stores converts to this currency with historical daily rates
/// (display rule #4); never add mixed currencies.
model Organization {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  baseCurrency String   @db.Char(3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stores         Store[]
  accessRequests StoreAccessRequest[]

  logo              String?
  metadata          String?
  organizationroles OrganizationRole[]
  members           Member[]
  invitations       Invitation[]

  digestSettings DigestSettings?
  digestSends    DigestSend[]

  askSettings      AskSettings?
  askConversations AskConversation[]
  askUsage         AskUsageMonthly[]
  booksSettings    BooksSettings?

  @@map("organizations")
}

/// One Shopify shop. A store belongs to exactly ONE organization, which is what
/// stops a second person linking a store they do not own (DECISIONS §6).
model Store {
  id              String   @id @default(uuid())
  organizationId  String
  shopDomain      String   @unique // *.myshopify.com, lowercase — the tenant key everywhere
  displayName     String?
  currency        String?  @db.Char(3) // from the app that owns the shop, never defaulted
  timezone        String? // IANA; every date filter is shown in this zone (rule #5)
  /// ISO-3166 alpha-2, the default region for normalising a phone written the
  /// local way (rule #19). §6.1 does not carry the shop's country today, so
  /// this is often inferred from the timezone — `countryInferred` says which,
  /// because an inference must never be mistaken for something an app said.
  country         String?  @db.Char(2)
  countryInferred Boolean  @default(false)
  claimedAt       DateTime @default(now())
  claimedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connections    AppConnection[]
  memberScopes   MemberStoreScope[]
  accessRequests StoreAccessRequest[]
  syncState      SyncState[]
  rawRecords     RawRecord[]
  inboundEvents  InboundEvent[]
  customers      Customer[]
  orderSnapshots OrderSnapshot[]
  shipmentEvents ShipmentEvent[]
  orderGrain     OrderGrain[]
  adSpend        AdSpend[]
  profitSettings StoreProfitSettings?
  insights       Insight[]
  insightOutcomes InsightOutcome[]
  buyerNetwork   BuyerNetwork[]
  orderNetwork   OrderNetwork[]
  appPrompts     AppPromptEvent[]
  plans          Plan[]
  cashForecasts  CashForecastSnapshot[]

  @@index([organizationId])
  @@map("stores")
}

enum CustomerIdentityKind {
  PHONE
  EMAIL
  SHOPIFY_ID
}

/// Growzar's own customer record (rule #19).
///
/// No app's customer count is ever displayed in Growzar. More than twenty
/// phone formats exist across the suite and Courierify groups by the raw
/// string, so its "customers" are spellings rather than people. This table is
/// the answer to "how many buyers do I actually have", and it is Growzar's to
/// compute because no single app can (§1.3).
///
/// Scoped to a store. A buyer at two of a merchant's shops is two
/// relationships until the buyer network says otherwise, and that is Q11/D-23,
/// deliberately not decided here.
model Customer {
  id      String @id @default(uuid())
  storeId String

  /// Display only, and the most recent one wins. Names are spelled many ways
  /// and none of them is a key.
  displayName String?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  /// Set when this record was folded into another. The row is kept so a
  /// metric computed before the merge can still be explained.
  mergedIntoId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store      Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  identities CustomerIdentity[]

  @@index([storeId, lastSeenAt])
  @@index([mergedIntoId])
  @@map("customers")
}

/// One way a buyer is known: a normalised phone, an email, or a Shopify
/// customer id. Two orders sharing any one of these are the same person.
///
/// The value is the NORMALISED form, which is what makes matching work; `raw`
/// keeps what the app actually sent, because a number Growzar could not parse
/// is still the number the merchant has to ring.
model CustomerIdentity {
  id         String               @id @default(uuid())
  customerId String
  storeId    String
  kind       CustomerIdentityKind
  value      String
  raw        String?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// One identity belongs to exactly one customer per store. This constraint
  /// is what makes the merge path necessary rather than optional — and what
  /// stops two racing syncs quietly creating two people from one buyer.
  @@unique([storeId, kind, value])
  @@index([customerId])
  @@map("customer_identities")
}

enum InboundEventStatus {
  PENDING
  PROCESSED
  /// Applied to nothing because a newer event for the same entity had already
  /// been applied. Not a failure — §7 guarantees no ordering.
  SUPERSEDED
  /// Accepted and stored, but nothing here knows how to act on it yet. Kept
  /// rather than dropped: the topic list grows, and an event we could not use
  /// in R1 is still evidence of what happened.
  IGNORED
  FAILED
}

/// The event relay's inbox (API-CONTRACT §7, X1).
///
/// Every signed event an app has sent, whether or not Growzar could act on it.
/// This table is three things at once: the deduplication key, the retry queue's
/// source of truth, and the per-store event log a merchant can look at to see
/// what fired and why.
model InboundEvent {
  id      String @id @default(uuid())
  /// The app generates it and never reuses it (§7). Unique here is what makes
  /// at-least-once delivery safe: a replay loses the insert race and is
  /// recognised as a replay rather than applied twice.
  eventId String @unique

  app        SuiteApp
  topic      String
  shopDomain String
  /// Null when the event names a shop Growzar has never had claimed. Kept
  /// anyway — an event arriving before its store is a fact worth seeing.
  storeId    String?

  /// When the thing happened, per the app. Ordering is by this, never by
  /// arrival (§7).
  occurredAt DateTime
  receivedAt DateTime @default(now())

  /// What the event is about, when it is about one thing —
  /// "shipment:SHP-1", "order:5123456789012". Used to decide whether a late
  /// arrival has already been overtaken.
  entityKey String?

  actor   Json?
  payload Json

  status      InboundEventStatus @default(PENDING)
  attempts    Int                @default(0)
  lastError   String?
  processedAt DateTime?

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, receivedAt])
  @@index([status])
  @@index([storeId, entityKey, occurredAt])
  @@map("inbound_events")
}

/// What each app owns, at the grain Growzar caches it.
enum SyncEntity {
  ORDER
  PARCEL
  SETTLEMENT
  COST
  /// Whether an order was confirmed, and how. Courierify serves this from
  /// OrderConfirmation / VoiceCallLog rather than an order's stage, and it is
  /// what I8 ("unconfirmed orders return more") is built on.
  CONFIRMATION
  /// Courierify's shipment status event log (G-GZR2-1). Stored at event grain
  /// in `shipment_events`, not in `raw_records`: it is immutable, it is the
  /// largest thing Growzar stores, and a JSONB copy of every row would roughly
  /// double its size for nothing.
  SHIPMENT_EVENT
  /// Financify's product catalogue, one row per variant (G-FIN3 follow-up,
  /// `/api/v1/products`): titles, SKU, status and image. Display only; the
  /// variant id stays the product key (rule #30).
  PRODUCT
  /// Inventorify (Phase 5, G-GZR5-1). Inventorify owns stock, units sold
  /// (rule #28) and purchase orders (rule #18); Growzar reads them, never
  /// re-derives them from Shopify. Every id is Inventorify's, numeric variant
  /// ids as strings.
  INVENTORY_VARIANT
  STOCK_LEVEL
  DAILY_SALES
  STOCK_SNAPSHOT
  PURCHASE_ORDER
  SUPPLIER
  RETURN_RESTOCK
  /// Retainify (Phase 5, G-GZR5-2): messages across email, WhatsApp and push,
  /// journeys and campaigns, enrollments, Shopify checkouts, and consent (its
  /// current state per contact, and its history). Buyer keys are email and
  /// phone; Growzar resolves them to its own customers where it uses them.
  MESSAGE
  JOURNEY
  ENROLLMENT
  CHECKOUT
  CONSENT
  CONSENT_EVENT
  /// Preventify (Phase 5, G-GZR5-8): COD-form orders with verification,
  /// network risk (labelled, never used to score) and offers taken; form
  /// abandonments; verification settings and their history; offers; dated
  /// offer events; blocked and OTP events.
  FORM_ORDER
  FORM_ABANDONMENT
  FORM_SETTINGS
  FORM_SETTINGS_CHANGE
  OFFER
  OFFER_EVENT
  FRAUD_EVENT
  /// WhatKaBot (Phase 5, G-GZR5-12). Its messages, COD confirmations and
  /// consent reuse MESSAGE, CONFIRMATION, CONSENT and CONSENT_EVENT: every
  /// reader filters by app, so they never mix with another app's rows.
  /// Metadata only: WhatKaBot exports no message text (D-55).
  CONVERSATION
  CONVERSATION_EVENT
  CAMPAIGN
  CAMPAIGN_RECIPIENT
  COMPLAINT
  RETURN_CASE
  SEARCH_MISS
}

enum SyncRunStatus {
  IDLE
  RUNNING
  FAILED
}

/// One cursor per store per app per entity (API-CONTRACT §6.2).
///
/// This row is what makes a sync resumable. The cursor is advanced only after
/// the page it came from has been written, so a worker killed mid-run restarts
/// from the last page it actually persisted — repeating some rows, which
/// dedupe absorbs, rather than skipping any.
model SyncState {
  id        String     @id @default(uuid())
  storeId   String
  app       SuiteApp
  entity    SyncEntity

  /// The app's opaque `nextCursor`. Null means "start from updatedSince".
  cursor    String?
  /// Inclusive high-water mark. §6.2: `updatedSince` is inclusive, so the last
  /// row repeats on the next run and is deduplicated rather than skipped.
  updatedSince DateTime?

  status         SyncRunStatus @default(IDLE)
  /// Set when a run starts, cleared when it ends. A row RUNNING for longer
  /// than the lease is a crashed worker, not a busy one.
  runStartedAt   DateTime?
  lastSuccessAt  DateTime?
  lastError      String?
  consecutiveFailures Int     @default(0)

  rowsWritten Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, app, entity])
  @@index([status])
  @@map("sync_state")
}

/// The raw cache: exactly what the app returned, at order and parcel grain.
///
/// Phase 2 computes every metric from these rows, so nothing derived is stored
/// here — a derived number would have to be recomputed from scratch anyway the
/// first time its formula changed, and by then the source would be gone.
/// Re-deriving must never need a re-fetch.
///
/// `externalId` is the canonical key from §3: the Shopify numeric order ID as a
/// string for orders, the owning app's shipment ID for parcels. Never an
/// order name, never a SKU.
model RawRecord {
  id         String     @id @default(uuid())
  storeId    String
  app        SuiteApp
  entity     SyncEntity
  externalId String

  /// The app's `updatedAt` for this row. Half of the dedupe key from §6.2:
  /// a row re-sent unchanged has the same (entity, id, updatedAt) and is not
  /// written again.
  sourceUpdatedAt DateTime

  /// Verbatim. Not reshaped, not normalized, not trimmed.
  payload Json

  /// §6.2 tombstone. The row is kept and marked rather than deleted, because
  /// a metric computed last week over a row that has since been deleted still
  /// has to be explicable.
  deletedAt DateTime?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, app, entity, externalId])
  @@index([storeId, entity, sourceUpdatedAt])
  @@map("raw_records")
}

/// Versioned, finalizing snapshots at ORDER grain, for COD money that settles
/// late.
///
/// The old hub had this idea at daily grain and got three things wrong. Each is
/// prevented here by construction rather than by care:
///
///  1. **Finalization collided on the second run.** Version numbers are
///     allocated under a unique constraint on (storeId, orderId, version), and
///     a collision is retried rather than crashing. Finalizing an order that is
///     already final does nothing.
///  2. **Change detection ignored costs, so late corrections never produced a
///     new version.** `contentHash` is over the canonical form of the WHOLE
///     payload. No field can be left out of the comparison, because no field is
///     named in it.
///  3. **Consumers summed every version and double-counted.** Superseded
///     versions carry `supersededAt`, and `latest_order_snapshots` is a view
///     that returns exactly one row per order. Consumers read the view.
model OrderSnapshot {
  id       String @id @default(uuid())
  storeId  String
  /// Shopify numeric order ID as a string (§3, rule #6).
  orderId  String
  version  Int

  /// True once the money can no longer change — settlement received and the
  /// return window closed. A final snapshot is never superseded.
  isFinal  Boolean @default(false)

  /// SHA-256 over the canonical JSON of `payload`. Equal hash means nothing
  /// changed and no version is written.
  contentHash String

  payload Json

  /// Set on every version except the newest. A consumer that filters on
  /// `supersededAt IS NULL` is correct even without the view.
  supersededAt DateTime?

  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, orderId, version])
  @@index([storeId, orderId, supersededAt])
  @@map("order_snapshots")
}

/// Every claim token Growzar has honoured, by its `jti` (API-CONTRACT §10).
///
/// This table is what makes a claim token single-use. The row is written in the
/// same transaction that consumes the token, and the unique constraint on
/// `jti` — not a prior read — is what actually stops a replay: two requests
/// arriving together both pass a "have I seen this?" check, and only one
/// survives the insert.
///
/// Rows outlive the 5-minute token deliberately. A token replayed an hour
/// later must still be refused, and the row is also the audit trail for which
/// app handed which shop to whom.
model ConsumedClaimToken {
  id        String   @id @default(uuid())
  jti       String   @unique
  app       SuiteApp
  shopDomain String
  email     String
  /// Null when the claim was consumed before the person finished signing up.
  userId    String?
  storeId   String?
  consumedAt DateTime @default(now())
  /// The token's own exp, kept so expired rows can be swept later without
  /// guessing how long tokens live.
  tokenExpiresAt DateTime

  @@index([shopDomain])
  @@map("consumed_claim_tokens")
}

/// A verified claim waiting for the person to finish signing in or signing up.
///
/// The token is consumed the moment it is verified — it is single-use and
/// short-lived, and holding it across a sign-up round trip would mean either
/// re-verifying an expired token or keeping it in a cookie. This row is the
/// server-side continuation instead: it says "this shop has been proven, by
/// this app, for this email", and nothing else can be done with it.
model PendingClaim {
  id           String   @id @default(uuid())
  app          SuiteApp
  shopDomain   String
  email        String
  shopifyUserId String?
  isStoreOwner Boolean
  locale       String?
  createdAt    DateTime @default(now())
  /// Short: long enough to sign up, not long enough to be a standing grant.
  expiresAt    DateTime
  consumedAt   DateTime?

  @@index([shopDomain])
  @@index([expiresAt])
  @@map("pending_claims")
}

enum StoreAccessRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

/// Someone who proved, through an app, that they work on a shop that another
/// organization has already claimed (DECISIONS §6).
///
/// Growzar never silently adds them and never creates a second store row. The
/// current owner approves or declines, and until then the requester sees a
/// waiting state. The same row type covers a store moving between
/// organizations, which is the same question with a different answer.
model StoreAccessRequest {
  id             String   @id @default(uuid())
  storeId        String
  /// The organization the requester wants the store to be reachable from.
  organizationId String
  requestedByUserId String
  app            SuiteApp
  /// True when the requester's token said isStoreOwner, which is what turns
  /// this into a move request rather than a join request.
  claimsOwnership Boolean  @default(false)
  status         StoreAccessRequestStatus @default(PENDING)
  decidedByUserId String?
  decidedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([storeId, requestedByUserId, status])
  @@index([storeId])
  @@index([organizationId])
  @@map("store_access_requests")
}

/// The other half of store scope (D-20): which stores a member may see when
/// their `scopeAllStores` is false.
///
/// A row here grants nothing on its own — the section × action permission from
/// the member's role is checked first, and this narrows *where* that permission
/// applies. Both are checked together in app/lib/authorize.server.ts, which is
/// the only place either is read.
model MemberStoreScope {
  id        String   @id @default(uuid())
  memberId  String
  storeId   String
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([memberId, storeId])
  @@index([memberId])
  @@index([storeId])
  @@map("member_store_scopes")
}

enum SuiteApp {
  COURIERIFY
  FINANCIFY
  WHATKABOT
  PREVENTIFY
  RETAINIFY
  INVENTORIFY
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED // app uninstalled; section enters reconnect mode (D-17)
  REINSTALL_NEEDED
  ERROR
}

/// One row per app per store. Auto-created when any app reports the shop as
/// installed, because the store is already proven (DECISIONS §6).
model AppConnection {
  id             String           @id @default(uuid())
  storeId        String
  app            SuiteApp
  status         ConnectionStatus @default(CONNECTED)
  /// What this app can do for this store in this release, from
  /// GET /api/v1/growzar/status (API-CONTRACT §11).
  capabilities   String[]         @default([])
  connectedAt    DateTime?
  disconnectedAt DateTime?
  /// D-17: data from an uninstalled app is deleted 30 days after this date.
  purgeAfter     DateTime?
  lastSyncedAt   DateTime?
  lastError      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, app])
  @@index([status])
  @@map("app_connections")
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model OrganizationRole {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  permission     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt

  @@index([organizationId])
  @@index([role])
  @@map("organizationRole")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  scopeAllStores Boolean? @default(true)

  /// Hand-added relation to Growzar's own scope table. The Better Auth
  /// generator only adds what is missing, so this survives regeneration —
  /// verified before it was written.
  storeScopes  MemberStoreScope[]
  /// Hand-added, like storeScopes: the weekly digest opt-out (G-GZR6-5).
  digestOptOut DigestOptOut?

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

/// One status event of one parcel, from Courierify's event log (G-GZR2-1).
///
/// Courierify prunes its backfilled history 90 days after it ran (late
/// December 2026), so this is Growzar's own copy, not a cache: once the source
/// is pruned, these rows are the only record of it.
///
/// Events are immutable at the source, so there is no update path and no
/// tombstone. A row here is written once and never changed.
model ShipmentEvent {
  id BigInt @id @default(autoincrement())
  storeId String

  /// Courierify's parcel id — the same id the PARCEL feed is keyed by. A
  /// parcel is not an order (rule #1).
  shipmentId String
  status         String
  previousStatus String?

  /// `backfill` is reconstructed from Courierify's statusHistory, a
  /// `tracking_poll` was observed, a `tracking_poll_correction` learned a
  /// courier time later. A metric that cannot tell these apart cannot explain
  /// itself, so the value is kept verbatim.
  source String

  /// When the courier says it happened. **Null when the courier said nothing,
  /// and never filled in** — a null is what makes a screen say "status as of"
  /// rather than "delivered on" (rule #9).
  courierEventAt DateTime?
  /// When Courierify saw it.
  observedAt DateTime
  /// The courier's own words for the status, when it gave any (≤160 chars).
  raw String?

  /// Courierify's event id. Not the dedupe key (see `eventKey`), but it is the
  /// tie-break when two events share an `observedAt`, and it is what a person
  /// tracing a row back to Courierify asks for.
  sourceEventId BigInt
  /// Courierify's `createdAt`: when the event was written, which is the
  /// feed's cursor. For backfilled events it is the day the backfill ran, not
  /// the day anything happened.
  sourceCreatedAt DateTime
  ingestedAt DateTime @default(now())

  /// `status|courierEventAt|observedAt` (epoch ms), with `-` for a null
  /// courier time.
  ///
  /// The pack keys an event by (shipmentId, status, courierEventAt,
  /// observedAt). A plain unique index over those columns would not dedupe
  /// anything whose courier time is null — Postgres treats NULLs as distinct —
  /// and that is 14% of the log. `NULLS NOT DISTINCT` fixes it but cannot be
  /// written in this schema, so the next `migrate dev` would drop it. This
  /// column is the same key in a form Prisma knows about. The `-` lives only
  /// here, never in `courierEventAt`.
  eventKey String

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Also the index a parcel's timeline is read through.
  @@unique([storeId, shipmentId, eventKey])
  @@map("shipment_events")
}

/// The order grain (G-GZR2-2): one row per order, rebuilt from synced rows by
/// app/lib/metrics/order-grain.server.ts. Every roll-up, screen and Phase 3
/// detector reads this table; nothing recomputes an order-level fact from
/// `raw_records` itself.
///
/// Derived, so it can always be dropped and rebuilt. `explain` holds, per
/// field, the rule, the source and the exact input rows.
model OrderGrain {
  storeId   String
  /// Shopify numeric order id, as a string (rule #6).
  orderId   String
  /// Display only, never a join key (rule #6).
  orderName String?
  createdAt DateTime?
  /// The store's local day, `YYYY-MM-DD` (rule #5). A string on purpose: a
  /// Date column invites someone to shift it by a timezone again.
  localDay  String?

  /// Rule #2: three kinds of revenue in three columns, never one.
  /// Order money is in the order's own currency (rule #4).
  currency        String?  @db.Char(3)
  placedAmount    Decimal? @db.Decimal(18, 6)
  deliveredAmount Decimal? @db.Decimal(18, 6)
  refundedAmount  Decimal? @db.Decimal(18, 6)
  discountsAmount Decimal? @db.Decimal(18, 6)
  shippingAmount  Decimal? @db.Decimal(18, 6)
  taxAmount       Decimal? @db.Decimal(18, 6)
  /// Cash paid by the courier (rule #17), in the COD's currency.
  collectedAmount   Decimal? @db.Decimal(18, 6)
  collectedCurrency String?  @db.Char(3)
  /// COD of delivered parcels no settlement has covered yet (G-GZR3-5, I4).
  uncollectedAmount   Decimal? @db.Decimal(18, 6)
  uncollectedCurrency String?  @db.Char(3)
  /// Costs are in the shop's currency, which can differ from the order's.
  cogsAmount         Decimal? @db.Decimal(18, 6)
  cogsCurrency       String?  @db.Char(3)
  cogsComplete       Boolean?
  courierFeeAmount   Decimal? @db.Decimal(18, 6)
  courierFeeCurrency String?  @db.Char(3)
  courierFeeSource   String?

  /// delivered | returned | partially_delivered | in_transit | booked |
  /// shipment_cancelled | order_cancelled | not_shipped | unknown
  outcome          String
  /// courierify | financify | none (rule #7)
  outcomeAuthority String
  /// happened_on | status_as_of (rule #9)
  outcomeBasis     String?
  outcomeAt        DateTime?
  /// Financify's own outcome (same vocabulary) and raw delivery status, kept
  /// even when Courierify is the authority, so disagreements are countable
  /// (G-GZR3-1). Null without a Financify row.
  financifyOutcome String?
  financifyStatus  String?
  orderCancelled    Boolean
  shipmentCancelled Boolean

  confirmation String?
  customerId   String?
  parcelCount  Int
  /// The first live parcel's courier, lower-cased (rule #12).
  courier      String?
  /// Courierify's `fulfilledVia` for the deciding parcel: "orio" | "shopify"
  /// | null (booked directly). Non-null means no courier times (G-GZR3-2).
  fulfilledVia String?
  /// Courierify's canonical city, or null = "unmapped" (rule #12).
  city         String?
  cityRaw      String?
  /// [{ variantId, productId, quantity }] — variant id is the product key (rule #30).
  lines   Json
  explain Json
  builtAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, orderId])
  @@index([storeId, localDay])
  @@map("order_grain")
}

/// Ad spend from Financify's `/api/v1/ad-spend` (G-GZR2-3), one row per
/// store × ad-platform day × level × key.
///
/// Days are the **ad account's reporting day** (`dateBasis:
/// "ad_platform_day"`), not the shop's local day, and every row keeps which
/// it is. Spend is in the shop's currency after Financify's conversion, with
/// the conversion's status kept beside it (rule #4, O-2).
///
/// `method` is `measured` for platform and campaign rows — the ad platform
/// reported them — and `allocated` for product rows, which Financify
/// distributes by evidence. An allocated figure is never presented as a
/// measured one.
model AdSpend {
  storeId  String
  day      String
  /// platform | campaign | product | product_unattributed
  level    String
  /// Platform name, campaign id, or variant id (rule #30).
  key      String
  platform String?

  spendAmount Decimal @db.Decimal(18, 6)
  feesAmount  Decimal @db.Decimal(18, 6)
  currency    String  @db.Char(3)
  /// measured | allocated
  method      String
  /// ok | conversion_failed | unknown — Financify's FX status.
  fxStatus    String?
  /// Campaign name, product title, evidence tiers, coverage, as sent.
  detail      Json
  fetchedAt   DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, day, level, key])
  @@map("ad_spend")
}

/// A store's profit settings in Financify, as last read from
/// `/api/v1/settings/profit` (rule #15, G-GZR2-4).
///
/// Five hidden per-store settings change what Financify's "net profit"
/// means. A roll-up across stores compares `settingsHash`; two different
/// hashes are flagged, never silently added. A store without Financify has
/// no row, which a roll-up reports as "settings unknown".
model StoreProfitSettings {
  storeId      String   @id
  settingsHash String
  /// `{ costBasis: { key, value }, … }` as Financify sent it.
  settings     Json
  /// Which settings are still Financify's defaults.
  isDefault    Json
  fetchedAt    DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_profit_settings")
}

/// The insight inbox (G-GZR3-3): one row per store × finding subject, so a
/// dismissal or snooze sticks to "this product's returns" across runs.
///
/// Written by the worker's evaluation after each grain rebuild (90 days,
/// which decides `lastSeenAt` and `resolvedAt`) and by Home, which creates a
/// row the first time it shows a finding so it can be acted on.
model Insight {
  id          String @id @default(uuid())
  storeId     String
  /// `detector:subject`, e.g. `variant_returns:45428908949606`.
  fingerprint String
  detector    String
  subject     String

  /// open | dismissed | snoozed. A snooze past `snoozedUntil` reads as open.
  status          String    @default("open")
  snoozedUntil    DateTime?
  /// wrong | already_knew | not_relevant | other: training data (DECISION-LAYER §5).
  dismissedReason String?
  dismissedNote   String?
  /// Who last dismissed, snoozed or reopened it.
  actedByUserId   String?
  actedAt         DateTime?

  firstSeenAt  DateTime  @default(now())
  /// The last evaluation that found it.
  lastSeenAt   DateTime  @default(now())
  /// Set when an evaluation stops finding it; cleared if it comes back. The
  /// success measure's "underlying state changed" (PLAN.md §9), observed,
  /// not attributed to any action.
  resolvedAt   DateTime?
  /// The few numbers the last evaluation saw (`evidenceOf`).
  lastEvidence Json      @default("{}")
  /// The whole finding the last 90-day evaluation saw, money included, and
  /// for state-based detectors the orders it was about (G-GZR9-1): what a
  /// click copies into its watch. Server-only, never sent to a browser.
  lastFinding  Json?

  store    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  events   InsightEvent[]
  outcomes InsightOutcome[]

  @@unique([storeId, fingerprint])
  @@index([storeId, status])
  @@map("insights")
}

/// What happened to an insight: shown → clicked → dismissed | snoozed |
/// reopened, and resolved | reappeared from evaluations (PLAN.md §9).
/// "shown" is recorded at most once per user, insight and store-local day.
model InsightEvent {
  id         String   @id @default(uuid())
  insightId  String
  storeId    String
  kind       String
  userId     String?
  /// The period the viewer had chosen (7, 30, 60 or 90 days).
  periodDays Int?
  /// Set only on "shown", as the store-local day: the dedupe key.
  day        String?
  detail     Json?
  at         DateTime @default(now())

  insight Insight @relation(fields: [insightId], references: [id], onDelete: Cascade)

  @@unique([insightId, kind, userId, day])
  @@index([storeId, at])
  @@map("insight_events")
}

/// A watch on what happened after someone acted on an insight (Phase 9,
/// G-GZR9-1): opened by the first click or app link, with the finding as it
/// stood (the baseline). The measurement engine fills checkpoints, verdict,
/// effect and money later. A finding that resolves with no watch is
/// "resolved on its own", never a result.
model InsightOutcome {
  id             String    @id @default(uuid())
  insightId      String
  storeId        String
  detector       String
  subject        String
  /// clicked | app_link (later: action, Phase 8). An observed change never opens a watch.
  trigger        String
  actedAt        DateTime
  actedByUserId  String?
  /// Opened by an internal account: measured, but kept out of totals and the replay statistics.
  internal       Boolean   @default(false)
  /// The finding at actedAt: `{ finding, items?, evidence, evaluatedAt, note? }`.
  baseline       Json
  /// snapshot | reconstructed | unavailable
  baselineSource String
  /// The "did it" signal, once seen (G-GZR9-4): upgrades the claim, never the trigger.
  observed       Json?
  checkpoints    Json      @default("[]")
  /// too_early | improved | no_change | worse | not_enough_data | closed
  verdict        String    @default("too_early")
  effect         Json?
  /// Computed and stored; shown only for approved detectors (D-38).
  money          Json?
  formulaVersion Int?
  judgedAt       DateTime?
  closedAt       DateTime?
  /// dismissed_wrong | store_disconnected
  closedReason   String?
  /// "This wasn't us": recorded, kept out of totals.
  hiddenAt       DateTime?
  hiddenByUserId String?
  hiddenNote     String?
  createdAt      DateTime  @default(now())

  insight Insight @relation(fields: [insightId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([insightId, actedAt])
  @@index([storeId, actedAt])
  @@map("insight_outcomes")
}

/// Daily exchange rates from Financify (G-FIN2-1, `GET /api/v1/fx`):
/// 1 `currency` = `rate` `base`, for `day`, the provider's UTC publication
/// day. Kept as served, a decimal string. A day or currency Financify has no
/// rate for has no row: never 1, never a nearby day's (rule #4).
model FxRate {
  base        String    @db.Char(3)
  currency    String    @db.Char(3)
  day         String
  rate        String
  source      String
  publishedAt DateTime?
  fetchedAt   DateTime  @default(now())

  @@id([base, currency, day])
  @@map("fx_rates")
}

/// Courierify's buyer network answer for one of the store's buyers
/// (G-GZR5-16; D-53, D-54), as of `fetchedAt`. Courierify's network and risk
/// rule are its own (D-54): Growzar stores and shows them, labelled as
/// Courierify's, and never rescores them. Figures are today's totals, so they
/// are never used to judge a past order (that needs G-CFY5-3's cut-off).
model BuyerNetwork {
  storeId    String
  /// The surviving customer (merges resolved) the phone was asked for.
  customerId String
  /// The E.164 phone Growzar asked with: the customer's most recently seen.
  phone      String
  /// ok | not_your_customer | invalid_phone
  status     String
  /// Courierify's figures at this store, as sent (orders, delivered, returned, …).
  storeFigures Json?
  /// Other stores' figures, as sent; Courierify nulls them under 2 other stores.
  network      Json?
  otherStores  Int?
  /// Courierify's label (insufficient_data | low | medium | high) and its stated basis.
  riskLevel  String?
  riskBasis  String?
  fetchedAt  DateTime

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, customerId])
  @@index([storeId, riskLevel])
  @@map("buyer_network")
}

/// Courierify's answer about an order's buyer as it stood when the order was
/// placed (G-CFY5-3's `before` = the order's createdAt), for I5 on network
/// history. Nothing after the order counts in it, so it never changes once
/// asked and judging a decided order with it is not hindsight.
model OrderNetwork {
  storeId    String
  orderId    String
  /// The E.164 phone asked with.
  phone      String
  /// ok | not_your_customer | invalid_phone
  status     String
  /// Courierify's label at the time (insufficient_data | low | medium | high).
  riskLevel  String?
  /// Other stores' orders and returns at the time; null under 2 other stores.
  otherStores     Int?
  networkOrders   Int?
  networkReturned Int?
  fetchedAt  DateTime

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, orderId])
  @@map("order_network")
}

/// Home's "Next app for your store" (G-GZR6-3): when a prompt for an app
/// the store lacks was shown and clicked, so installs can be traced to it.
/// "shown" is kept at most once per user, app and store-local day.
model AppPromptEvent {
  id      String   @id @default(uuid())
  storeId String
  /// The suite app pitched (PREVENTIFY, RETAINIFY, …).
  app     String
  /// shown | clicked
  kind    String
  userId  String?
  /// Set only on "shown": the dedupe key.
  day     String?
  /// Whether it was the lead prompt or a listed one.
  detail  Json?
  at      DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, app, kind, userId, day])
  @@index([storeId, app])
  @@map("app_prompt_events")
}

/// The weekly digest (G-GZR6-5, D-57): whether an organization sends it.
/// Off until an owner or admin turns it on from the preview page.
model DigestSettings {
  organizationId  String    @id
  enabled         Boolean   @default(false)
  changedByUserId String?
  changedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("digest_settings")
}

/// A member who does not want the weekly digest. No row means subscribed.
model DigestOptOut {
  memberId String   @id
  /// settings | email | email_header (the mail client's one-click unsubscribe)
  via      String
  at       DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("digest_opt_outs")
}

/// One digest for one member and week, or one test send: what it held and
/// what became of it. Kept when the member leaves, as history.
model DigestSend {
  id             String    @id @default(uuid())
  organizationId String
  memberId       String
  userId         String
  /// The address it went to (or would have).
  email          String
  /// email; WhatsApp later.
  channel        String    @default("email")
  /// live | dry_run | test
  mode           String
  /// The recipient's local Monday, YYYY-MM-DD.
  week           String
  /// `memberId:week:mode` for live and dry runs, so each is made once a week;
  /// unique per row for a test.
  dedupeKey      String    @unique
  /// sending | sent | failed | dry_run | opted_out | empty | no_api_key
  status         String
  attempts       Int       @default(0)
  providerId     String?
  error          String?
  /// Per store: the findings and app lead as written, or why it was left out.
  content        Json
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([memberId])
  @@map("digest_sends")
}

/// "Talk to your data" (Phase 10): whether an organization has it, and what
/// it may spend a month. Off until an owner or admin turns it on (G-GZR10-6).
model AskSettings {
  organizationId   String    @id
  enabled          Boolean   @default(false)
  /// US dollars in millionths: 5000000 is $5 (B5, 2026-10-19).
  monthlyCapMicros BigInt    @default(5000000)
  changedByUserId  String?
  changedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("ask_settings")
}

/// One thread of questions by one member.
model AskConversation {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  /// The stores the member could see when it started.
  storeIds       String[]
  startedAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     AskMessage[]

  @@index([organizationId, userId, startedAt])
  @@map("ask_conversations")
}

/// A question or an answer. Text and tool results are cleared after the
/// retention period (B6, 90 days); usage, outcome and feedback stay.
model AskMessage {
  id              String    @id @default(uuid())
  conversationId  String
  /// user | assistant
  role            String
  text            String?
  /// The tool calls and their (guarded, aggregate-only) results, in order.
  toolCalls       Json?
  /// The tools whose results the answer was drawn from.
  toolResultRefs  String[]
  model           String?
  /// answered | refused | limit | disabled | timeout | error (assistant only)
  status          String?
  inputTokens     Int       @default(0)
  cachedTokens    Int       @default(0)
  outputTokens    Int       @default(0)
  reasoningTokens Int       @default(0)
  /// US dollars in millionths.
  costMicros      BigInt    @default(0)
  latencyMs       Int?
  /// Every number in the text matched a tool result (G-GZR10-4); null until checked.
  grounded        Boolean?
  /// What the checks found: numbers that matched nothing and the sentences dropped for them (G-GZR10-4).
  checks          Json?
  /// up | down
  feedback        String?
  feedbackNote    String?
  redactedAt      DateTime?
  createdAt       DateTime  @default(now())

  conversation AskConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([createdAt])
  @@map("ask_messages")
}

/// What an organization's questions cost each month (UTC), for the cap.
model AskUsageMonthly {
  organizationId String
  /// YYYY-MM, UTC.
  month          String
  questions      Int    @default(0)
  inputTokens    BigInt @default(0)
  cachedTokens   BigInt @default(0)
  outputTokens   BigInt @default(0)
  costMicros     BigInt @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, month])
  @@map("ask_usage_monthly")
}

/// A budget plan the simulator made (G-GZR11-6, pack §5.6): what was asked,
/// what came back, and as of when, so a merchant can come back to it and
/// Phase 9's outcome engine can later compare plan and actual.
model Plan {
  id             String   @id @default(uuid())
  storeId        String
  organizationId String
  createdById    String
  createdAt      DateTime @default(now())
  /// The data the plan was made from stood at this moment.
  asOf           DateTime
  /// The simulator's version, so an old plan is read by the rules it was made with.
  version        String
  /// plan | refused
  status         String
  /// The SimRequest as submitted.
  inputs         Json
  /// The Plan (lines, totals, assumptions, what was left out) or the refusal's fix list.
  output         Json

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@map("plans")
}

/// A store's cash forecast as made at the start of a week (D-94), kept so Plan
/// can show it, once the week has passed, against what happened: paid by
/// courier (Courierify) and received in bank (Books). One per store and week.
model CashForecastSnapshot {
  id        String   @id @default(uuid())
  storeId   String
  /// The Monday (UTC) of the week the forecast was made in.
  week      DateTime @db.Date
  /// The data the forecast was made from stood at this moment.
  asOf      DateTime
  /// The CashForecast as Plan showed it.
  forecast  Json
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, week])
  @@map("cash_forecast_snapshots")
}

/// A recurring entry (Books v1.1 V6, ported from Financify): an entry's
/// contents and a schedule; each due date becomes a draft (D-101: drafts by
/// default) or is saved straight to the books.
model BkRecurring {
  id          String    @id @default(cuid())
  bookId      String
  name        String
  /// The kind of entry it makes, and its contents (as a document's data).
  type        String
  contactId   String?
  memo        String?
  data        Json
  /// The store the entries carry (D-65), copied from the entry it was made from.
  storeId     String?
  /// Bills and invoices: days from the entry's date to its due date.
  dueDays     Int?
  /// weekly | monthly | yearly
  frequency   String
  interval    Int       @default(1)
  /// Monthly and yearly: the day of the month (29–31 fall back to the month's last day).
  dayOfMonth  Int?
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  /// The next date to make; null once it has ended.
  nextDate    DateTime? @db.Date
  /// draft | auto
  mode        String    @default("draft")
  paused      Boolean   @default(false)
  lastRunAt   DateTime?
  lastMessage String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  book BkBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([nextDate])
  @@map("bk_recurring")
}

/// A receipt or bill kept with an entry (Books v1.1 V6, ported from
/// Financify): stored in the database, a photo shrunk in the browser or a
/// PDF, at most 900 KB. Never leaves Books; deleted with its entry.
model BkAttachment {
  id          String   @id @default(cuid())
  bookId      String
  documentId  String
  fileName    String
  contentType String
  size        Int
  data        Bytes
  createdBy   String?
  createdAt   DateTime @default(now())

  document BkDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([bookId])
  @@map("bk_attachments")
}

/// Books for an organization (D-91): off until turned on, behind BOOKS_ENABLED
/// on the server too. During the pilot only internal accounts turn it on.
model BooksSettings {
  organizationId  String    @id
  enabled         Boolean   @default(false)
  changedByUserId String?
  changedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("books_settings")
}

// ── Books (B1, D-62..D-91) ──────────────────────────────────────────────────
// Ported from Financify's Books at 0cc8732. The database enforces what Prisma
// can't: balanced entries, permanent posted history and the closed-period lock
// (migration 20261022120000_books_engine).

model BkBook {
  id                   String    @id @default(cuid())
  /// One book per organization (D-65). No relation: books outlive an uninstall (D-71).
  organizationId       String    @unique
  /// ISO 4217. Fixed once anything is posted.
  currency             String    @db.VarChar(3)
  /// Minor units per major unit as a power of ten (PKR/USD 2, JPY 0).
  currencyDecimals     Int       @default(2)
  /// 1–12. July (7) for Pakistan.
  fiscalYearStartMonth Int       @default(7)
  /// Nothing may be posted on or before this date.
  lockedThrough        DateTime? @db.Date
  settings             Json      @default("{}")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accounts         BkAccount[]
  contacts         BkContact[]
  documents        BkDocument[]
  recurring        BkRecurring[]
  connectors       BkConnector[]
  parcelEvents     BkParcelEvent[]
  statementImports BkStatementImport[]
  statementLines   BkStatementLine[]
  bankRules        BkBankRule[]
  reconciliations  BkReconciliation[]
  statementMatches BkStatementMatch[]
  parcels          BkParcel[]
  courierSheets    BkCourierSheet[]
  taxRates         BkTaxRate[]

  @@map("bk_books")
}

model BkAccount {
  id         String    @id @default(cuid())
  bookId     String
  code       String
  name       String
  /// asset | liability | equity | income | expense
  type       String
  /// bank | cash | card | ad_wallet | receivable | payable | stock | tax | other …
  subtype    String    @default("other")
  /// Accounts the engine relies on (opening_balance, retained_earnings…). Renamable, never archivable.
  systemKey  String?
  /// A sub-account rolls up into its parent in reports (one level deep).
  parentId   String?
  /// Money accounts only: the account's own currency when it isn't the book's (a USD card).
  currency   String?   @db.VarChar(3)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  book BkBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, code])
  @@unique([bookId, systemKey])
  @@index([bookId, type])
  @@map("bk_accounts")
}

model BkContact {
  id            String    @id @default(cuid())
  bookId        String
  name          String
  /// supplier | customer | courier | gateway | ad_platform | other
  kinds         String[]
  email         String?
  phone         String?
  notes         String?
  /// Last account used with this contact, offered first next time.
  lastAccountId String?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  book BkBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, name])
  @@map("bk_contacts")
}

model BkDocument {
  id           String    @id @default(cuid())
  bookId       String
  /// expense | money_in | transfer | owner_in | owner_out | opening | manual
  type         String
  /// Assigned on posting, gapless per type (EXP-0001).
  number       String?
  /// draft | posted | cancelled
  status       String    @default("draft")
  date         DateTime  @db.Date
  contactId    String?
  /// The form as entered (validated per type); the posting engine reads only this.
  data         Json
  /// Base-currency minor units, for lists.
  total        BigInt    @default(0)
  memo         String?
  /// manual, or an importer's key.
  source       String    @default("manual")
  sourceRef    String?
  /// The store it belongs to (D-65); null for organization-level items such as rent.
  storeId      String?
  /// Free labels (a sales channel, a brand) for reports by tag. Not part of the ledger.
  tags         String[]  @default([])
  createdBy    String?
  postedAt     DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  book         BkBook          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  entries      BkEntry[]
  attachments  BkAttachment[]
  parcelEvents BkParcelEvent[]

  @@unique([bookId, source, sourceRef])
  @@unique([bookId, number])
  @@index([bookId, status, date])
  @@index([bookId, type, date])
  @@index([bookId, contactId])
  @@index([tags], type: Gin)
  @@map("bk_documents")
}

model BkSequence {
  bookId String
  prefix String
  next   Int    @default(1)

  @@id([bookId, prefix])
  @@map("bk_sequences")
}

model BkEntry {
  id         String   @id @default(cuid())
  bookId     String
  documentId String
  /// post | cancel
  kind       String
  date       DateTime @db.Date
  createdAt  DateTime @default(now())

  document BkDocument    @relation(fields: [documentId], references: [id], onDelete: Restrict)
  lines    BkEntryLine[]

  @@index([bookId, date])
  @@index([documentId])
  @@map("bk_entries")
}

model BkEntryLine {
  id          BigInt   @id @default(autoincrement())
  entryId     String
  bookId      String
  accountId   String
  contactId   String?
  /// Copied from the document: the store dimension of every report (D-65).
  storeId     String?
  /// Signed base-currency minor units: + debit, − credit.
  amount      BigInt
  /// Lines on a foreign-currency account: the amount in that currency (same sign as `amount`).
  fxAmount    BigInt?
  /// Copied from the entry so balances are one index scan.
  date        DateTime @db.Date
  description String?

  entry BkEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@index([bookId, accountId, date])
  @@index([bookId, storeId, accountId, date])
  @@index([bookId, contactId])
  @@index([entryId])
  @@map("bk_entry_lines")
}

model BkAuditEvent {
  id         BigInt   @id @default(autoincrement())
  bookId     String
  /// Growzar user id; null for connectors and the worker.
  actor      String?
  action     String
  documentId String?
  detail     Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([bookId, createdAt])
  @@index([documentId])
  @@map("bk_audit_events")
}

model BkConnector {
  id            String    @id @default(cuid())
  bookId        String
  /// shopify_sales | courierify_payouts | ad_spend | bank_statements
  key           String
  enabled       Boolean   @default(false)
  /// draft | auto
  mode          String    @default("draft")
  /// First day to bring in.
  startDate     DateTime? @db.Date
  /// Account mapping and source options, validated per connector.
  settings      Json      @default("{}")
  /// Last whole day brought in; the next run starts the day after.
  syncedThrough DateTime? @db.Date
  /// Set while a run is in progress (a run older than 15 minutes is treated as dead).
  runningSince  DateTime?
  lastRunAt     DateTime?
  lastStatus    String?
  lastMessage   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  book BkBook           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  runs BkConnectorRun[]

  @@unique([bookId, key])
  @@map("bk_connectors")
}

model BkConnectorRun {
  id          String    @id @default(cuid())
  connectorId String
  bookId      String
  /// manual | auto | preview
  trigger     String
  /// running | ok | partial | error
  status      String    @default("running")
  fromDate    DateTime? @db.Date
  toDate      DateTime? @db.Date
  created     Int       @default(0)
  updated     Int       @default(0)
  skipped     Int       @default(0)
  message     String?
  detail      Json      @default("{}")
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  connector BkConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId, startedAt])
  @@map("bk_connector_runs")
}

model BkAllocation {
  id        String    @id @default(cuid())
  bookId    String
  paymentId String
  billId    String
  amount    BigInt
  voidedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([bookId, billId])
  @@index([paymentId])
  @@map("bk_allocations")
}

model BkTaxRate {
  id         String    @id @default(cuid())
  bookId     String
  name       String
  /// sales | purchase | withholding
  kind       String
  /// Basis points: 1800 = 18%.
  rateBp     Int
  /// Where the tax goes; null only for purchase tax that can't be claimed (it joins the cost).
  accountId  String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  book BkBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, name])
  @@map("bk_tax_rates")
}

/// A cash-on-delivery order's change on a sales day (B3c; Financify's
/// bk_parcel_events): held until delivered or paid, released, returned,
/// adjusted, reinstated, or "skip" (nothing to take back). `lines` are signed
/// account amounts in minor units; a day's events are part of its sales entry.
model BkParcelEvent {
  id         String   @id @default(cuid())
  bookId     String
  /// The store the order belongs to (D-65).
  storeId    String?
  orderId    String
  orderName  String
  day        DateTime @db.Date
  kind       String
  lines      Json
  documentId String?
  createdAt  DateTime @default(now())

  book     BkBook      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  document BkDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([bookId, orderId, day, kind])
  @@index([bookId, day])
  @@map("bk_parcel_events")
}

// Banking (B5a), ported from Financify's books_bank and books_bank_matching.

model BkStatementImport {
  id          String    @id @default(cuid())
  bookId      String
  accountId   String
  fileName    String?
  added       Int
  duplicates  Int
  firstDate   DateTime? @db.Date
  lastDate    DateTime? @db.Date
  /// What the running balance showed: breaks inside the file, or a gap/overlap with the import before it.
  balanceNote String?
  createdBy   String?
  createdAt   DateTime  @default(now())

  book  BkBook            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  lines BkStatementLine[]

  @@index([bookId, accountId])
  @@map("bk_statement_imports")
}

model BkStatementLine {
  id          BigInt    @id @default(autoincrement())
  bookId      String
  accountId   String
  importId    String
  date        DateTime  @db.Date
  description String
  /// Minor units: + money into the account, − money out.
  amount      BigInt
  balance     BigInt?
  /// Same line in another import has the same key (see statement-csv lineKeys).
  key         String
  /// open | matched | ignored
  status      String    @default("open")
  /// The ledger line (on this account) it was matched to. Not a foreign key:
  /// ledger lines are insert-only and purged first.
  entryLineId BigInt?   @unique
  documentId  String?
  /// Matched as part of a group (several lines and/or several entries whose
  /// totals agree — a deposit of two payouts, a payment split across lines, a
  /// fee difference, a reversal pair). The group's entry lines are in
  /// bk_statement_matches. A line is matched either by entryLineId or by group.
  matchGroup  String?
  /// Looks like a line already imported from another file (same date and amount).
  dupOfId     BigInt?
  matchedAt   DateTime?
  createdAt   DateTime  @default(now())

  book   BkBook            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  import BkStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([bookId, accountId, key])
  @@index([bookId, matchGroup])
  @@index([bookId, accountId, status, date])
  @@map("bk_statement_lines")
}

model BkBankRule {
  id        String   @id @default(cuid())
  bookId    String
  contains  String
  /// out | in
  direction String
  accountId String
  contactId String?
  /// Only lines between these amounts (minor units, positive); null = any.
  minAmount BigInt?
  maxAmount BigInt?
  /// account: an expense or money in; transfer: money moved to/from another of your accounts (accountId).
  kind      String   @default("account")
  /// A split: [{accountId, percent}] summing to 100 (kind "account" only); null = all to accountId.
  split     Json?
  createdAt DateTime @default(now())

  book BkBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, direction, contains])
  @@map("bk_bank_rules")
}

model BkReconciliation {
  id               String    @id @default(cuid())
  bookId           String
  accountId        String
  statementDate    DateTime  @db.Date
  /// Ledger sign (+ debit), converted from what the statement shows.
  statementBalance BigInt
  /// open | done
  status           String    @default("open")
  createdBy        String?
  createdAt        DateTime  @default(now())
  finishedAt       DateTime?

  book    BkBook          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  cleared BkClearedLine[]

  @@index([bookId, accountId, status])
  @@map("bk_reconciliations")
}

model BkClearedLine {
  entryLineId      BigInt   @id
  bookId           String
  accountId        String
  reconciliationId String
  amount           BigInt
  createdAt        DateTime @default(now())

  reconciliation BkReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([reconciliationId])
  @@index([bookId, accountId])
  @@map("bk_cleared_lines")
}

model BkStatementMatch {
  id          String   @id @default(cuid())
  bookId      String
  groupId     String
  /// A ledger line belongs to at most one match.
  entryLineId BigInt   @unique
  createdAt   DateTime @default(now())

  book BkBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, groupId])
  @@map("bk_statement_matches")
}

// The parcel register and courier sheets (B5b), ported from Financify's books_parcel_register and books_courier_sheets.

model BkParcel {
  id             String    @id @default(cuid())
  bookId         String
  orderId        String
  orderName      String
  /// The store the order belongs to (D-65).
  storeId        String?
  placedDay      DateTime  @db.Date
  /// The account it's owed through (cash on delivery).
  accountId      String
  /// Owed when the order came in, and owed now by Books' own rules (after
  /// returns, cancellations, edits and parcels back; before payouts and write-offs).
  saleOwed       BigInt    @default(0)
  owed           BigInt    @default(0)
  shipped        Boolean?
  courier        String?
  trackingNumber String?
  trackingStatus String?
  trackingAt     DateTime?
  deliveredAt    DateTime?
  /// Courierify's booking: its charges and the amount to collect.
  bookedFees     BigInt?
  codAmount      BigInt?
  /// Courierify's payout for it, when the courier has paid it out.
  settlementRef  String?
  settledAt      DateTime?
  settledNet     BigInt?
  settledFees    BigInt?
  /// What Books did: the payout entry that cleared it (gross), write-offs, damage.
  payoutDocId    String?
  paid           BigInt    @default(0)
  writeoffDocId  String?
  writtenOff     BigInt    @default(0)
  damagedDocId   String?
  damaged        BigInt    @default(0)
  checkedAt      DateTime?
  /// What a courier's settlement file said: delivered | returned (it outranks tracking for returns).
  settledStatus  String?
  /// The loadsheet the parcel was dispatched on, and when.
  loadsheetId    String?
  dispatchedOn   DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  book BkBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, orderId])
  @@index([bookId, courier])
  @@index([bookId, placedDay])
  @@index([bookId, settlementRef])
  @@map("bk_parcels")
}

model BkCourierSheet {
  id         String   @id @default(cuid())
  bookId     String
  /// settlement | loadsheet
  kind       String
  courier    String
  /// The courier's own number for it (payment or loadsheet number); "" when none.
  ref        String   @default("")
  /// Payment date (settlement) or dispatch date (loadsheet).
  date       DateTime @db.Date
  /// file | api
  source     String   @default("file")
  fileName   String?
  /// draft | recorded | discarded
  status     String   @default("draft")
  /// Totals as read, and what Books did with them.
  totals     Json     @default("{}")
  documentId String?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  book  BkBook               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  lines BkCourierSheetLine[]

  @@index([bookId, kind, status])
  @@index([bookId, courier, ref])
  @@map("bk_courier_sheets")
}

model BkCourierSheetLine {
  id        BigInt  @id @default(autoincrement())
  sheetId   String
  bookId    String
  row       Int
  tracking  String?
  orderRef  String?
  /// The parcel it matched in the register, if any.
  parcelId  String?
  /// delivered | returned | other
  status    String
  rawStatus String?
  cod       BigInt  @default(0)
  collected BigInt  @default(0)
  delivery  BigInt  @default(0)
  returnFee BigInt  @default(0)
  salesTax  BigInt  @default(0)
  withheld  BigInt  @default(0)
  otherFees BigInt  @default(0)
  net       BigInt  @default(0)
  note      String?

  sheet BkCourierSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([sheetId])
  @@index([bookId, tracking])
  @@index([bookId, parcelId])
  @@map("bk_courier_sheet_lines")
}
