// Growzar schema — skeleton for Phase 1.
//
// Scope of this file today: the tenancy spine (organization, store, app
// connection) plus the Better Auth models below the AppConnection block.
//
// Everything from `model User` down is GENERATED. `npm run auth:generate`
// rewrites it from app/lib/auth.server.ts; edit that config, not these models,
// or the next regeneration silently reverts you. Their table names stay at
// Better Auth's defaults (singular, camelCase) because `modelName` renames the
// Prisma model too, and `prisma.organization_roles` is a worse trade than a
// mixed table convention.
//
// Deliberately absent until their Phase 1 day: the synced order/parcel cache,
// the Growzar customer record, and the event relay's inbox.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the URL lives in prisma.config.ts (migrations) and in the pg
  // driver adapter (runtime). It is deliberately absent here.
}

/// The merchant's company. One base currency, one owner.
/// Money across stores converts to this currency with historical daily rates
/// (display rule #4); never add mixed currencies.
model Organization {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  baseCurrency String   @db.Char(3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stores         Store[]
  accessRequests StoreAccessRequest[]

  logo              String?
  metadata          String?
  organizationroles OrganizationRole[]
  members           Member[]
  invitations       Invitation[]

  @@map("organizations")
}

/// One Shopify shop. A store belongs to exactly ONE organization, which is what
/// stops a second person linking a store they do not own (DECISIONS §6).
model Store {
  id              String   @id @default(uuid())
  organizationId  String
  shopDomain      String   @unique // *.myshopify.com, lowercase — the tenant key everywhere
  displayName     String?
  currency        String?  @db.Char(3) // from the app that owns the shop, never defaulted
  timezone        String? // IANA; every date filter is shown in this zone (rule #5)
  /// ISO-3166 alpha-2, the default region for normalising a phone written the
  /// local way (rule #19). §6.1 does not carry the shop's country today, so
  /// this is often inferred from the timezone — `countryInferred` says which,
  /// because an inference must never be mistaken for something an app said.
  country         String?  @db.Char(2)
  countryInferred Boolean  @default(false)
  claimedAt       DateTime @default(now())
  claimedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connections    AppConnection[]
  memberScopes   MemberStoreScope[]
  accessRequests StoreAccessRequest[]
  syncState      SyncState[]
  rawRecords     RawRecord[]
  inboundEvents  InboundEvent[]
  customers      Customer[]
  orderSnapshots OrderSnapshot[]
  shipmentEvents ShipmentEvent[]
  orderGrain     OrderGrain[]
  adSpend        AdSpend[]
  profitSettings StoreProfitSettings?
  insights       Insight[]

  @@index([organizationId])
  @@map("stores")
}

enum CustomerIdentityKind {
  PHONE
  EMAIL
  SHOPIFY_ID
}

/// Growzar's own customer record (rule #19).
///
/// No app's customer count is ever displayed in Growzar. More than twenty
/// phone formats exist across the suite and Courierify groups by the raw
/// string, so its "customers" are spellings rather than people. This table is
/// the answer to "how many buyers do I actually have", and it is Growzar's to
/// compute because no single app can (§1.3).
///
/// Scoped to a store. A buyer at two of a merchant's shops is two
/// relationships until the buyer network says otherwise, and that is Q11/D-23,
/// deliberately not decided here.
model Customer {
  id      String @id @default(uuid())
  storeId String

  /// Display only, and the most recent one wins. Names are spelled many ways
  /// and none of them is a key.
  displayName String?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  /// Set when this record was folded into another. The row is kept so a
  /// metric computed before the merge can still be explained.
  mergedIntoId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store      Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  identities CustomerIdentity[]

  @@index([storeId, lastSeenAt])
  @@index([mergedIntoId])
  @@map("customers")
}

/// One way a buyer is known: a normalised phone, an email, or a Shopify
/// customer id. Two orders sharing any one of these are the same person.
///
/// The value is the NORMALISED form, which is what makes matching work; `raw`
/// keeps what the app actually sent, because a number Growzar could not parse
/// is still the number the merchant has to ring.
model CustomerIdentity {
  id         String               @id @default(uuid())
  customerId String
  storeId    String
  kind       CustomerIdentityKind
  value      String
  raw        String?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// One identity belongs to exactly one customer per store. This constraint
  /// is what makes the merge path necessary rather than optional — and what
  /// stops two racing syncs quietly creating two people from one buyer.
  @@unique([storeId, kind, value])
  @@index([customerId])
  @@map("customer_identities")
}

enum InboundEventStatus {
  PENDING
  PROCESSED
  /// Applied to nothing because a newer event for the same entity had already
  /// been applied. Not a failure — §7 guarantees no ordering.
  SUPERSEDED
  /// Accepted and stored, but nothing here knows how to act on it yet. Kept
  /// rather than dropped: the topic list grows, and an event we could not use
  /// in R1 is still evidence of what happened.
  IGNORED
  FAILED
}

/// The event relay's inbox (API-CONTRACT §7, X1).
///
/// Every signed event an app has sent, whether or not Growzar could act on it.
/// This table is three things at once: the deduplication key, the retry queue's
/// source of truth, and the per-store event log a merchant can look at to see
/// what fired and why.
model InboundEvent {
  id      String @id @default(uuid())
  /// The app generates it and never reuses it (§7). Unique here is what makes
  /// at-least-once delivery safe: a replay loses the insert race and is
  /// recognised as a replay rather than applied twice.
  eventId String @unique

  app        SuiteApp
  topic      String
  shopDomain String
  /// Null when the event names a shop Growzar has never had claimed. Kept
  /// anyway — an event arriving before its store is a fact worth seeing.
  storeId    String?

  /// When the thing happened, per the app. Ordering is by this, never by
  /// arrival (§7).
  occurredAt DateTime
  receivedAt DateTime @default(now())

  /// What the event is about, when it is about one thing —
  /// "shipment:SHP-1", "order:5123456789012". Used to decide whether a late
  /// arrival has already been overtaken.
  entityKey String?

  actor   Json?
  payload Json

  status      InboundEventStatus @default(PENDING)
  attempts    Int                @default(0)
  lastError   String?
  processedAt DateTime?

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, receivedAt])
  @@index([status])
  @@index([storeId, entityKey, occurredAt])
  @@map("inbound_events")
}

/// What each app owns, at the grain Growzar caches it.
enum SyncEntity {
  ORDER
  PARCEL
  SETTLEMENT
  COST
  /// Whether an order was confirmed, and how. Courierify serves this from
  /// OrderConfirmation / VoiceCallLog rather than an order's stage, and it is
  /// what I8 ("unconfirmed orders return more") is built on.
  CONFIRMATION
  /// Courierify's shipment status event log (G-GZR2-1). Stored at event grain
  /// in `shipment_events`, not in `raw_records`: it is immutable, it is the
  /// largest thing Growzar stores, and a JSONB copy of every row would roughly
  /// double its size for nothing.
  SHIPMENT_EVENT
}

enum SyncRunStatus {
  IDLE
  RUNNING
  FAILED
}

/// One cursor per store per app per entity (API-CONTRACT §6.2).
///
/// This row is what makes a sync resumable. The cursor is advanced only after
/// the page it came from has been written, so a worker killed mid-run restarts
/// from the last page it actually persisted — repeating some rows, which
/// dedupe absorbs, rather than skipping any.
model SyncState {
  id        String     @id @default(uuid())
  storeId   String
  app       SuiteApp
  entity    SyncEntity

  /// The app's opaque `nextCursor`. Null means "start from updatedSince".
  cursor    String?
  /// Inclusive high-water mark. §6.2: `updatedSince` is inclusive, so the last
  /// row repeats on the next run and is deduplicated rather than skipped.
  updatedSince DateTime?

  status         SyncRunStatus @default(IDLE)
  /// Set when a run starts, cleared when it ends. A row RUNNING for longer
  /// than the lease is a crashed worker, not a busy one.
  runStartedAt   DateTime?
  lastSuccessAt  DateTime?
  lastError      String?
  consecutiveFailures Int     @default(0)

  rowsWritten Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, app, entity])
  @@index([status])
  @@map("sync_state")
}

/// The raw cache: exactly what the app returned, at order and parcel grain.
///
/// Phase 2 computes every metric from these rows, so nothing derived is stored
/// here — a derived number would have to be recomputed from scratch anyway the
/// first time its formula changed, and by then the source would be gone.
/// Re-deriving must never need a re-fetch.
///
/// `externalId` is the canonical key from §3: the Shopify numeric order ID as a
/// string for orders, the owning app's shipment ID for parcels. Never an
/// order name, never a SKU.
model RawRecord {
  id         String     @id @default(uuid())
  storeId    String
  app        SuiteApp
  entity     SyncEntity
  externalId String

  /// The app's `updatedAt` for this row. Half of the dedupe key from §6.2:
  /// a row re-sent unchanged has the same (entity, id, updatedAt) and is not
  /// written again.
  sourceUpdatedAt DateTime

  /// Verbatim. Not reshaped, not normalized, not trimmed.
  payload Json

  /// §6.2 tombstone. The row is kept and marked rather than deleted, because
  /// a metric computed last week over a row that has since been deleted still
  /// has to be explicable.
  deletedAt DateTime?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, app, entity, externalId])
  @@index([storeId, entity, sourceUpdatedAt])
  @@map("raw_records")
}

/// Versioned, finalizing snapshots at ORDER grain, for COD money that settles
/// late.
///
/// The old hub had this idea at daily grain and got three things wrong. Each is
/// prevented here by construction rather than by care:
///
///  1. **Finalization collided on the second run.** Version numbers are
///     allocated under a unique constraint on (storeId, orderId, version), and
///     a collision is retried rather than crashing. Finalizing an order that is
///     already final does nothing.
///  2. **Change detection ignored costs, so late corrections never produced a
///     new version.** `contentHash` is over the canonical form of the WHOLE
///     payload. No field can be left out of the comparison, because no field is
///     named in it.
///  3. **Consumers summed every version and double-counted.** Superseded
///     versions carry `supersededAt`, and `latest_order_snapshots` is a view
///     that returns exactly one row per order. Consumers read the view.
model OrderSnapshot {
  id       String @id @default(uuid())
  storeId  String
  /// Shopify numeric order ID as a string (§3, rule #6).
  orderId  String
  version  Int

  /// True once the money can no longer change — settlement received and the
  /// return window closed. A final snapshot is never superseded.
  isFinal  Boolean @default(false)

  /// SHA-256 over the canonical JSON of `payload`. Equal hash means nothing
  /// changed and no version is written.
  contentHash String

  payload Json

  /// Set on every version except the newest. A consumer that filters on
  /// `supersededAt IS NULL` is correct even without the view.
  supersededAt DateTime?

  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, orderId, version])
  @@index([storeId, orderId, supersededAt])
  @@map("order_snapshots")
}

/// Every claim token Growzar has honoured, by its `jti` (API-CONTRACT §10).
///
/// This table is what makes a claim token single-use. The row is written in the
/// same transaction that consumes the token, and the unique constraint on
/// `jti` — not a prior read — is what actually stops a replay: two requests
/// arriving together both pass a "have I seen this?" check, and only one
/// survives the insert.
///
/// Rows outlive the 5-minute token deliberately. A token replayed an hour
/// later must still be refused, and the row is also the audit trail for which
/// app handed which shop to whom.
model ConsumedClaimToken {
  id        String   @id @default(uuid())
  jti       String   @unique
  app       SuiteApp
  shopDomain String
  email     String
  /// Null when the claim was consumed before the person finished signing up.
  userId    String?
  storeId   String?
  consumedAt DateTime @default(now())
  /// The token's own exp, kept so expired rows can be swept later without
  /// guessing how long tokens live.
  tokenExpiresAt DateTime

  @@index([shopDomain])
  @@map("consumed_claim_tokens")
}

/// A verified claim waiting for the person to finish signing in or signing up.
///
/// The token is consumed the moment it is verified — it is single-use and
/// short-lived, and holding it across a sign-up round trip would mean either
/// re-verifying an expired token or keeping it in a cookie. This row is the
/// server-side continuation instead: it says "this shop has been proven, by
/// this app, for this email", and nothing else can be done with it.
model PendingClaim {
  id           String   @id @default(uuid())
  app          SuiteApp
  shopDomain   String
  email        String
  shopifyUserId String?
  isStoreOwner Boolean
  locale       String?
  createdAt    DateTime @default(now())
  /// Short: long enough to sign up, not long enough to be a standing grant.
  expiresAt    DateTime
  consumedAt   DateTime?

  @@index([shopDomain])
  @@index([expiresAt])
  @@map("pending_claims")
}

enum StoreAccessRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

/// Someone who proved, through an app, that they work on a shop that another
/// organization has already claimed (DECISIONS §6).
///
/// Growzar never silently adds them and never creates a second store row. The
/// current owner approves or declines, and until then the requester sees a
/// waiting state. The same row type covers a store moving between
/// organizations, which is the same question with a different answer.
model StoreAccessRequest {
  id             String   @id @default(uuid())
  storeId        String
  /// The organization the requester wants the store to be reachable from.
  organizationId String
  requestedByUserId String
  app            SuiteApp
  /// True when the requester's token said isStoreOwner, which is what turns
  /// this into a move request rather than a join request.
  claimsOwnership Boolean  @default(false)
  status         StoreAccessRequestStatus @default(PENDING)
  decidedByUserId String?
  decidedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([storeId, requestedByUserId, status])
  @@index([storeId])
  @@index([organizationId])
  @@map("store_access_requests")
}

/// The other half of store scope (D-20): which stores a member may see when
/// their `scopeAllStores` is false.
///
/// A row here grants nothing on its own — the section × action permission from
/// the member's role is checked first, and this narrows *where* that permission
/// applies. Both are checked together in app/lib/authorize.server.ts, which is
/// the only place either is read.
model MemberStoreScope {
  id        String   @id @default(uuid())
  memberId  String
  storeId   String
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([memberId, storeId])
  @@index([memberId])
  @@index([storeId])
  @@map("member_store_scopes")
}

enum SuiteApp {
  COURIERIFY
  FINANCIFY
  WHATKABOT
  PREVENTIFY
  RETAINIFY
  INVENTORIFY
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED // app uninstalled; section enters reconnect mode (D-17)
  REINSTALL_NEEDED
  ERROR
}

/// One row per app per store. Auto-created when any app reports the shop as
/// installed, because the store is already proven (DECISIONS §6).
model AppConnection {
  id             String           @id @default(uuid())
  storeId        String
  app            SuiteApp
  status         ConnectionStatus @default(CONNECTED)
  /// What this app can do for this store in this release, from
  /// GET /api/v1/growzar/status (API-CONTRACT §11).
  capabilities   String[]         @default([])
  connectedAt    DateTime?
  disconnectedAt DateTime?
  /// D-17: data from an uninstalled app is deleted 30 days after this date.
  purgeAfter     DateTime?
  lastSyncedAt   DateTime?
  lastError      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, app])
  @@index([status])
  @@map("app_connections")
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model OrganizationRole {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  permission     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt

  @@index([organizationId])
  @@index([role])
  @@map("organizationRole")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  scopeAllStores Boolean? @default(true)

  /// Hand-added relation to Growzar's own scope table. The Better Auth
  /// generator only adds what is missing, so this survives regeneration —
  /// verified before it was written.
  storeScopes MemberStoreScope[]

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

/// One status event of one parcel, from Courierify's event log (G-GZR2-1).
///
/// Courierify prunes its backfilled history 90 days after it ran (late
/// December 2026), so this is Growzar's own copy, not a cache: once the source
/// is pruned, these rows are the only record of it.
///
/// Events are immutable at the source, so there is no update path and no
/// tombstone. A row here is written once and never changed.
model ShipmentEvent {
  id BigInt @id @default(autoincrement())
  storeId String

  /// Courierify's parcel id — the same id the PARCEL feed is keyed by. A
  /// parcel is not an order (rule #1).
  shipmentId String
  status         String
  previousStatus String?

  /// `backfill` is reconstructed from Courierify's statusHistory, a
  /// `tracking_poll` was observed, a `tracking_poll_correction` learned a
  /// courier time later. A metric that cannot tell these apart cannot explain
  /// itself, so the value is kept verbatim.
  source String

  /// When the courier says it happened. **Null when the courier said nothing,
  /// and never filled in** — a null is what makes a screen say "status as of"
  /// rather than "delivered on" (rule #9).
  courierEventAt DateTime?
  /// When Courierify saw it.
  observedAt DateTime
  /// The courier's own words for the status, when it gave any (≤160 chars).
  raw String?

  /// Courierify's event id. Not the dedupe key (see `eventKey`), but it is the
  /// tie-break when two events share an `observedAt`, and it is what a person
  /// tracing a row back to Courierify asks for.
  sourceEventId BigInt
  /// Courierify's `createdAt`: when the event was written, which is the
  /// feed's cursor. For backfilled events it is the day the backfill ran, not
  /// the day anything happened.
  sourceCreatedAt DateTime
  ingestedAt DateTime @default(now())

  /// `status|courierEventAt|observedAt` (epoch ms), with `-` for a null
  /// courier time.
  ///
  /// The pack keys an event by (shipmentId, status, courierEventAt,
  /// observedAt). A plain unique index over those columns would not dedupe
  /// anything whose courier time is null — Postgres treats NULLs as distinct —
  /// and that is 14% of the log. `NULLS NOT DISTINCT` fixes it but cannot be
  /// written in this schema, so the next `migrate dev` would drop it. This
  /// column is the same key in a form Prisma knows about. The `-` lives only
  /// here, never in `courierEventAt`.
  eventKey String

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Also the index a parcel's timeline is read through.
  @@unique([storeId, shipmentId, eventKey])
  @@map("shipment_events")
}

/// The order grain (G-GZR2-2): one row per order, rebuilt from synced rows by
/// app/lib/metrics/order-grain.server.ts. Every roll-up, screen and Phase 3
/// detector reads this table; nothing recomputes an order-level fact from
/// `raw_records` itself.
///
/// Derived, so it can always be dropped and rebuilt. `explain` holds, per
/// field, the rule, the source and the exact input rows.
model OrderGrain {
  storeId   String
  /// Shopify numeric order id, as a string (rule #6).
  orderId   String
  /// Display only, never a join key (rule #6).
  orderName String?
  createdAt DateTime?
  /// The store's local day, `YYYY-MM-DD` (rule #5). A string on purpose: a
  /// Date column invites someone to shift it by a timezone again.
  localDay  String?

  /// Rule #2: three kinds of revenue in three columns, never one.
  /// Order money is in the order's own currency (rule #4).
  currency        String?  @db.Char(3)
  placedAmount    Decimal? @db.Decimal(18, 6)
  deliveredAmount Decimal? @db.Decimal(18, 6)
  refundedAmount  Decimal? @db.Decimal(18, 6)
  discountsAmount Decimal? @db.Decimal(18, 6)
  shippingAmount  Decimal? @db.Decimal(18, 6)
  taxAmount       Decimal? @db.Decimal(18, 6)
  /// Cash paid by the courier (rule #17), in the COD's currency.
  collectedAmount   Decimal? @db.Decimal(18, 6)
  collectedCurrency String?  @db.Char(3)
  /// Costs are in the shop's currency, which can differ from the order's.
  cogsAmount         Decimal? @db.Decimal(18, 6)
  cogsCurrency       String?  @db.Char(3)
  cogsComplete       Boolean?
  courierFeeAmount   Decimal? @db.Decimal(18, 6)
  courierFeeCurrency String?  @db.Char(3)
  courierFeeSource   String?

  /// delivered | returned | partially_delivered | in_transit | booked |
  /// shipment_cancelled | order_cancelled | not_shipped | unknown
  outcome          String
  /// courierify | financify | none (rule #7)
  outcomeAuthority String
  /// happened_on | status_as_of (rule #9)
  outcomeBasis     String?
  outcomeAt        DateTime?
  /// Financify's own outcome (same vocabulary) and raw delivery status, kept
  /// even when Courierify is the authority, so disagreements are countable
  /// (G-GZR3-1). Null without a Financify row.
  financifyOutcome String?
  financifyStatus  String?
  orderCancelled    Boolean
  shipmentCancelled Boolean

  confirmation String?
  customerId   String?
  parcelCount  Int
  /// The first live parcel's courier, lower-cased (rule #12).
  courier      String?
  /// Courierify's `fulfilledVia` for the deciding parcel: "orio" | "shopify"
  /// | null (booked directly). Non-null means no courier times (G-GZR3-2).
  fulfilledVia String?
  /// Courierify's canonical city, or null = "unmapped" (rule #12).
  city         String?
  cityRaw      String?
  /// [{ variantId, productId, quantity }] — variant id is the product key (rule #30).
  lines   Json
  explain Json
  builtAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, orderId])
  @@index([storeId, localDay])
  @@map("order_grain")
}

/// Ad spend from Financify's `/api/v1/ad-spend` (G-GZR2-3), one row per
/// store × ad-platform day × level × key.
///
/// Days are the **ad account's reporting day** (`dateBasis:
/// "ad_platform_day"`), not the shop's local day, and every row keeps which
/// it is. Spend is in the shop's currency after Financify's conversion, with
/// the conversion's status kept beside it (rule #4, O-2).
///
/// `method` is `measured` for platform and campaign rows — the ad platform
/// reported them — and `allocated` for product rows, which Financify
/// distributes by evidence. An allocated figure is never presented as a
/// measured one.
model AdSpend {
  storeId  String
  day      String
  /// platform | campaign | product | product_unattributed
  level    String
  /// Platform name, campaign id, or variant id (rule #30).
  key      String
  platform String?

  spendAmount Decimal @db.Decimal(18, 6)
  feesAmount  Decimal @db.Decimal(18, 6)
  currency    String  @db.Char(3)
  /// measured | allocated
  method      String
  /// ok | conversion_failed | unknown — Financify's FX status.
  fxStatus    String?
  /// Campaign name, product title, evidence tiers, coverage, as sent.
  detail      Json
  fetchedAt   DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, day, level, key])
  @@map("ad_spend")
}

/// A store's profit settings in Financify, as last read from
/// `/api/v1/settings/profit` (rule #15, G-GZR2-4).
///
/// Five hidden per-store settings change what Financify's "net profit"
/// means. A roll-up across stores compares `settingsHash`; two different
/// hashes are flagged, never silently added. A store without Financify has
/// no row, which a roll-up reports as "settings unknown".
model StoreProfitSettings {
  storeId      String   @id
  settingsHash String
  /// `{ costBasis: { key, value }, … }` as Financify sent it.
  settings     Json
  /// Which settings are still Financify's defaults.
  isDefault    Json
  fetchedAt    DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_profit_settings")
}

/// The insight inbox (G-GZR3-3): one row per store × finding subject, so a
/// dismissal or snooze sticks to "this product's returns" across runs.
///
/// Written by the worker's evaluation after each grain rebuild (90 days,
/// which decides `lastSeenAt` and `resolvedAt`) and by Home, which creates a
/// row the first time it shows a finding so it can be acted on.
model Insight {
  id          String @id @default(uuid())
  storeId     String
  /// `detector:subject`, e.g. `variant_returns:45428908949606`.
  fingerprint String
  detector    String
  subject     String

  /// open | dismissed | snoozed. A snooze past `snoozedUntil` reads as open.
  status          String    @default("open")
  snoozedUntil    DateTime?
  /// wrong | already_knew | not_relevant | other: training data (DECISION-LAYER §5).
  dismissedReason String?
  dismissedNote   String?
  /// Who last dismissed, snoozed or reopened it.
  actedByUserId   String?
  actedAt         DateTime?

  firstSeenAt  DateTime  @default(now())
  /// The last evaluation that found it.
  lastSeenAt   DateTime  @default(now())
  /// Set when an evaluation stops finding it; cleared if it comes back. The
  /// success measure's "underlying state changed" (PLAN.md §9), observed,
  /// not attributed to any action.
  resolvedAt   DateTime?
  /// The few numbers the last evaluation saw (`evidenceOf`).
  lastEvidence Json      @default("{}")

  store  Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  events InsightEvent[]

  @@unique([storeId, fingerprint])
  @@index([storeId, status])
  @@map("insights")
}

/// What happened to an insight: shown → clicked → dismissed | snoozed |
/// reopened, and resolved | reappeared from evaluations (PLAN.md §9).
/// "shown" is recorded at most once per user, insight and store-local day.
model InsightEvent {
  id         String   @id @default(uuid())
  insightId  String
  storeId    String
  kind       String
  userId     String?
  /// The period the viewer had chosen (7, 30, 60 or 90 days).
  periodDays Int?
  /// Set only on "shown", as the store-local day: the dedupe key.
  day        String?
  detail     Json?
  at         DateTime @default(now())

  insight Insight @relation(fields: [insightId], references: [id], onDelete: Cascade)

  @@unique([insightId, kind, userId, day])
  @@index([storeId, at])
  @@map("insight_events")
}
