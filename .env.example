# Growzar — copy to .env and fill in. Never commit .env.
# On the server this file lives at /etc/growzar/growzar.env, root-owned, mode 600,
# and is loaded by systemd (docs/deploy/growzar.service), not by PM2 — PM2 has
# served stale secrets on these hosts twice.

NODE_ENV=development
TZ=UTC
PORT=3020
GROWZAR_VERSION=dev

# Postgres on this box. Keep connection_limit at 4 for web and 2 for the worker:
# the growzar_app role is capped at 6 until max_connections goes 100 -> 130.
DATABASE_URL="postgresql://growzar_app:CHANGE_ME@127.0.0.1:5432/growzar?connection_limit=4&pool_timeout=10"

# Redis is already running on this box (also used by Courierify's BullMQ).
# Use a distinct key prefix so the queues never collide.
REDIS_URL="redis://127.0.0.1:6379"
BULLMQ_PREFIX="growzar"

# Better Auth
# BETTER_AUTH_URL decides the cookie names: an https URL gets __Secure-prefixed
# cookies, which a browser will not send back over plain http. Local work on
# 127.0.0.1 therefore needs the http form, or you sign in and immediately look
# signed out.
BETTER_AUTH_SECRET="CHANGE_ME_32_BYTES_BASE64"
BETTER_AUTH_URL="https://portal.growzar.com"   # local dev: http://127.0.0.1:3020

# Outbound email for magic links and invitations (the old hub used Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Growzar <no-reply@growzar.com>"

# Encryption at rest for anything sensitive Growzar stores (AES-256-GCM helper
# lifted from the old hub). 32 bytes, base64.
ENCRYPTION_KEY="CHANGE_ME_32_BYTES_BASE64"

# --- Platform credentials, one per app (API-CONTRACT §2) ---
# Bearer key + HMAC secret. Growzar authenticates as itself; never a
# merchant-pasted key, never gated by an app's plan (D-31).
COURIERIFY_BASE_URL="https://courierify.growzar.com"
COURIERIFY_PLATFORM_KEY=""
COURIERIFY_SIGNING_SECRET=""

FINANCIFY_BASE_URL=""
FINANCIFY_PLATFORM_KEY=""
FINANCIFY_SIGNING_SECRET=""

WHATKABOT_BASE_URL=""
WHATKABOT_PLATFORM_KEY=""
WHATKABOT_SIGNING_SECRET=""

PREVENTIFY_BASE_URL=""
PREVENTIFY_PLATFORM_KEY=""
PREVENTIFY_SIGNING_SECRET=""

RETAINIFY_BASE_URL=""
RETAINIFY_PLATFORM_KEY=""
RETAINIFY_SIGNING_SECRET=""

INVENTORIFY_BASE_URL=""
INVENTORIFY_PLATFORM_KEY=""
INVENTORIFY_SIGNING_SECRET=""

# Sync politeness: Growzar polls apps that run on this same box.
SYNC_INTERVAL_SECONDS=300
SYNC_QUIET_HOURS_UTC="05:00-15:00"   # Pakistan business hours; no backfills
