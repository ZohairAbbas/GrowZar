{
  "name": "growzar",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node --env-file=.env ./node_modules/.bin/react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "start:local": "node --env-file=.env ./node_modules/.bin/react-router-serve ./build/server/index.js",
    "worker": "node --enable-source-maps ./build/worker/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "auth:generate": "node --env-file=.env ./node_modules/.bin/better-auth generate --config app/lib/auth.server.ts -y",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed:holidays": "tsx scripts/seed-holiday-calendar.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "better-auth": "1.7.5",
    "bullmq": "6.3.8",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "ioredis": "6.0.0",
    "isbot": "^5.1.0",
    "lucide-react": "^1.47.0",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "8.4.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.22",
    "@react-router/dev": "8.4.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^18.0.3",
    "postcss": "^8.5.0",
    "prisma": "7.10.0",
    "tailwindcss": "3.4.19",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^3.2.0"
  }
}
